		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <LangVersion>10.0</LangVersion>
		<IsPackable>false</IsPackable>
        <Company>DraviaVemal</Company>
