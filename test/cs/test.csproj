	<ItemGroup>
		<PackageReference Include="coverlet.msbuild" Version="6.0.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="6.0.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="3.5.0" />
		<PackageReference Include="MSTest.TestFramework" Version="3.5.0" />
		<!-- Legacy package used only by the standalone benchmark (Benchmark.cs) for comparison -->
		<PackageReference Include="OpenXMLOffice.Spreadsheet" Version="2.9.0" />
		<ProjectReference Include="..\..\cs\openxml_office.csproj" />
		<Content Include="assets\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<Target Name="CopyEditTestFiles" AfterTargets="Build">
		<ItemGroup>
			<EditTestFiles Include="$(ProjectDir)..\edit_test_files\**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(EditTestFiles)" DestinationFolder="$(TargetDir)edit_test_files\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>
</Project>