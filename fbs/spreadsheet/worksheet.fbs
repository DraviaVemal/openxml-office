include "../global/drawing.fbs";

namespace openxml_office_fbs.spreadsheet;

// Common worksheet properties - Start

enum Worksheet_cell_data_type: byte{
    auto=0,
    number=1,
    boolean=2,
    string=3,
    shared_string=4,
    inline_string=5,
    error=6,
}

table Worksheet_column_properties{
    min: uint32;
    max: uint32;
    width: float = null;
    hidden: bool = null;
    best_fit: bool = null;
    style_id_ptr: uint64 = null;
}

table Worksheet_cell_property{
    value: string;
    formula: string;
    data_type: Worksheet_cell_data_type;
    style_id_ptr: uint64 = null;
}

// Common worksheet properties - End

// Worksheet_set_column_ref_properties - Start

table Worksheet_set_column_ref_properties{
    worksheet_ptr: uint64;
    cell_ref: string;
    column_properties: Worksheet_column_properties;
}

// Worksheet_set_column_ref_properties - End

// Worksheet_set_column_index_properties - Start

table Worksheet_set_column_index_properties{
    worksheet_ptr: uint64;
    column_index: uint16;
    column_properties: Worksheet_column_properties;
}

// Worksheet_set_column_index_properties - End

// worksheet_set_row_ref_properties - Start

table Worksheet_set_row_index_properties{
    worksheet_ptr: uint64;
    row_index: uint32;
    row_properties: Worksheet_row_properties(required);
}

table Worksheet_row_properties{
    height: float = null;
    hidden: bool = null;
    thick_top: bool = null;
    thick_bottom: bool = null;
    style_id_ptr: uint64 = null;
}
// worksheet_set_row_ref_properties - End

// Worksheet set cell ref value - Start

table Worksheet_set_cell_ref_value{
    worksheet_ptr: uint64;
    cell_ref: string;
    column_cells: [Worksheet_cell_property](required);
}

// Worksheet set cell ref value - End

// Worksheet set cell index value - Start

table Worksheet_set_cell_index_value{
    worksheet_ptr: uint64;
    row_index: uint32;
    column_index: uint16;
    column_cells: [Worksheet_cell_property](required);
}

// Worksheet set cell index value - End

// Worksheet flush - Start

table Worksheet_flush{
    worksheet_ptr: uint64;
}

// Worksheet flush - End

// Common reference range - Start

table Worksheet_reference_range {
    column_start: uint16;
    column_end: uint16;
    row_start: uint32;
    row_end: uint32;
}

// Common reference range - End

// Worksheet_set_merge_cell - Start

table Worksheet_set_merge_cell {
    worksheet_ptr: uint64;
    ref_range: Worksheet_reference_range(required);
}

// Worksheet_set_merge_cell - End

// Worksheet_remove_merge_cell - Start

table Worksheet_remove_merge_cell {
    worksheet_ptr: uint64;
    ref_range: Worksheet_reference_range(required);
}

// Worksheet_remove_merge_cell - End

// Worksheet_set_hyperlink - Start

table Worksheet_set_hyperlink {
    worksheet_ptr: uint64;
    display: string;
    link: string;
    ref_range: Worksheet_reference_range(required);
}

// Worksheet_set_hyperlink - End

// Worksheet_remove_hyperlink - Start

table Worksheet_remove_hyperlink {
    worksheet_ptr: uint64;
    ref_range: Worksheet_reference_range(required);
}

// Worksheet_remove_hyperlink - End

// Worksheet_delete_sheet - Start

table Worksheet_delete_sheet {
    worksheet_ptr: uint64;
}

// Worksheet_delete_sheet - End

// Worksheet_get_range_cell_properties - Start

table Worksheet_get_range_cell_properties {
    worksheet_ptr: uint64;
    ref_range: Worksheet_reference_range(required);
}

table Worksheet_cell_package {
    cell_ref: string;
    row_index: uint32;
    column_index: uint16;
    cell_property: Worksheet_cell_property;
}

table Worksheet_get_range_cell_properties_return {
    cell_packages: [Worksheet_cell_package];
}

// Worksheet_get_range_cell_properties - End

// Worksheet_list_merge_cell - Start

table Worksheet_list_merge_cell {
    worksheet_ptr: uint64;
}

table Worksheet_list_merge_cell_return {
    ranges: [Worksheet_reference_range];
}

// Worksheet_list_merge_cell - End

// Worksheet_list_hyperlinks - Start

table Worksheet_list_hyperlinks {
    worksheet_ptr: uint64;
}

table Worksheet_hyperlink {
    display: string;
    link: string;
    ref_range: Worksheet_reference_range;
}

table Worksheet_list_hyperlinks_return {
    hyperlinks: [Worksheet_hyperlink];
}

// Worksheet_list_hyperlinks - End

// Worksheet_add_picture - Start

table Worksheet_anchor_position {
    column: uint16;
    column_offset: uint64;
    row: uint32;
    row_offset: uint64;
}

enum Worksheet_excel_hyperlink_type: byte {
    existing_file = 0,
    web_url = 1,
    target_sheet = 2,
}

table Worksheet_excel_hyperlink {
    display: string;
    link_type: Worksheet_excel_hyperlink_type;
    link: string;
}

table Worksheet_picture_setting {
    picture_settings: openxml_office_fbs.global.Global_picture_settings(required);
    from: Worksheet_anchor_position(required);
    to: Worksheet_anchor_position(required);
    hyperlink: Worksheet_excel_hyperlink;
}

table Worksheet_add_picture {
    worksheet_ptr: uint64;
    image_path: string;
    picture_setting: Worksheet_picture_setting(required);
}

// Worksheet_add_picture - End
