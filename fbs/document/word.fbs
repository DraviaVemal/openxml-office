namespace openxml_office_fbs.document;

// Word_create - Start

table Word_create {
    file_name: string;
    word_settings: Word_settings(required);
}

table Word_settings {
    is_editable: bool;
}

table Word_create_return {
    word_ptr: uint64;
}

// document_create - End

// Word_save_as - Start

table Word_save_as {
    word_ptr: uint64;
    file_name: string;
}

table Word_save_as_return {
    full_path: string;
}

// Word_save_as - End